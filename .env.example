# From the Turso dashboard: database URL and a token for that database.
# https:// URLs are accepted. Do not commit the real values; put them in .env.local.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Stripe keys are entered under Staff terminal → Business. Do not put them in this file.
# Password reset and checkout receipts. Without SMTP_HOST and SMTP_FROM, production does not send email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
