# Staff terminal overrides (optional — defaults work for local demo)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=kitchen-local
# SESSION_SECRET=change-me-in-production

# Trigger.dev — required for `npm run trigger:dev` and deploys
# Project ref: cloud.trigger.dev → your project → Project settings
TRIGGER_PROJECT_REF=proj_replace_me
# Secret key: cloud.trigger.dev → API keys (dev key for local)
TRIGGER_SECRET_KEY=
